{
  "name": "y-transport",
  "version": "0.1.0",
  "description": "Yjs sync for v13 and v14 over WebTransport with a WebSocket fallback, many documents per connection, plus a Node server for both.",
  "keywords": [
    "awareness",
    "crdt",
    "local-first",
    "provider",
    "sync",
    "websocket",
    "webtransport",
    "yjs",
    "yjs-v14"
  ],
  "homepage": "https://github.com/KarolNov/y-providers/tree/main/packages/y-transport#readme",
  "bugs": {
    "url": "https://github.com/KarolNov/y-providers/issues"
  },
  "license": "MIT",
  "author": "Karol Novljaković",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarolNov/y-providers.git",
    "directory": "packages/y-transport"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./y14": {
      "types": "./dist/y14.d.ts",
      "import": "./dist/y14.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/y14": {
      "types": "./dist/server/y14.d.ts",
      "import": "./dist/server/y14.js"
    },
    "./server/ws": {
      "types": "./dist/server/ws.d.ts",
      "import": "./dist/server/ws.js"
    },
    "./server/webtransport": {
      "types": "./dist/server/webtransport.d.ts",
      "import": "./dist/server/webtransport.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:node": "vitest run --project node-v13 --project node-v14",
    "test:browser": "vitest run --project browser-v13 --project browser-v14",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.y14.json"
  },
  "dependencies": {
    "lib0": "^0.2.99",
    "y-append-log": "workspace:^"
  },
  "devDependencies": {
    "@fails-components/webtransport": "^1.6.8",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.8",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@y/protocols": "1.0.6-rc.1",
    "@y/y": "14.0.0-rc.30",
    "playwright": "^1.63.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "peerDependencies": {
    "@fails-components/webtransport": "^1.6.0",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.0",
    "@y/protocols": ">=1.0.6-rc.1",
    "@y/y": ">=14.0.0-rc.30 <15",
    "ws": "^8.0.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "@fails-components/webtransport": {
      "optional": true
    },
    "@fails-components/webtransport-transport-http3-quiche": {
      "optional": true
    },
    "@y/protocols": {
      "optional": true
    },
    "@y/y": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "y-protocols": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
