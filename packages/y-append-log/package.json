{
  "name": "y-append-log",
  "version": "0.1.0",
  "description": "An append-only, crash-safe log of Yjs updates and the per-document storage contract, for Yjs v13 and v14.",
  "keywords": [
    "append-log",
    "compaction",
    "crdt",
    "persistence",
    "storage",
    "yjs",
    "yjs-v14"
  ],
  "homepage": "https://github.com/KarolNov/y-providers/tree/main/packages/y-append-log#readme",
  "bugs": {
    "url": "https://github.com/KarolNov/y-providers/issues"
  },
  "license": "MIT",
  "author": "Karol Novljaković",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarolNov/y-providers.git",
    "directory": "packages/y-append-log"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./y14": {
      "types": "./dist/y14.d.ts",
      "import": "./dist/y14.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:node": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.y14.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@y/y": "14.0.0-rc.30",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3",
    "yjs": "^13.6.0"
  },
  "peerDependencies": {
    "@y/y": ">=14.0.0-rc.30 <15",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "@y/y": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
