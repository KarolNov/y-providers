{
  "name": "y-opfs",
  "version": "0.1.0",
  "description": "Yjs persistence for v13 and v14: an append-only OPFS log with IndexedDB fallback, live sync between tabs, and a Node filesystem adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarolNov/y-providers.git",
    "directory": "packages/y-opfs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./y14": {
      "types": "./dist/y14.d.ts",
      "import": "./dist/y14.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:node": "vitest run --project node-v13 --project node-v14",
    "test:browser": "vitest run --project browser-v13 --project browser-v14 --project private-browsing-v13 --project private-browsing-v14",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.y14.json"
  },
  "dependencies": {
    "y-append-log": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@y/y": "14.0.0-rc.30",
    "playwright": "^1.63.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yjs": "^13.6.0"
  },
  "peerDependencies": {
    "@y/y": ">=14.0.0-rc.30 <15",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "@y/y": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  }
}
